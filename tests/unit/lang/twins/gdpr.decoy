decoy 1

pipeline {
  seed 42

  table users from csv("./users.csv") to csv("./users_masked.csv") {
    full_name : faker(person_name)
    email     : faker(person_email)
    phone     : faker(person_phone)
    ip_address, user_agent : redact
    device_id : hash in device_identity
    keep country
    city        : faker(address_city)
    postal_code : truncate(length: 3)
    national_id, passport_number, ethnicity, religion, health_condition : redact
    salary : shuffle
  }
}
